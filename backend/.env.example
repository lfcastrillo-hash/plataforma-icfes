PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://prepicfes_test:fixture_local_only@127.0.0.1:5433/prepicfes_test
DATABASE_SSL=false
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Solo durante migración revisada de cuentas antiguas; desactivar al terminar.
ALLOW_LEGACY_PASSWORDS=false
# Orígenes adicionales separados por comas. Mismo origen no necesita CORS.
CORS_ORIGINS=
OPENROUTER_API_KEY=
# Identificador de modelo habilitado en su cuenta; no se asume disponibilidad.
OPENROUTER_MODEL=
